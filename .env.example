NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYMENT_PROVIDER=chip
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
MURPATI_BASE_URL=https://api.murpati.com
MURPATI_API_KEY=
MURPATI_SESSION_ID=
MURPATI_BATCH_LIMIT=50
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_USER_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_PAYMENT_CHANNEL=0
TOYYIBPAY_PAYMENT_PAGE_BASE_URL=
TOYYIBPAY_RETURN_URL=
TOYYIBPAY_CALLBACK_URL=
TOYYIBPAY_CALLBACK_TOKEN=
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_RETURN_URL=
BILLPLZ_CALLBACK_URL=
BILLPLZ_CALLBACK_TOKEN=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_ENFORCE_X_SIGNATURE=true
BILLPLZ_AUTO_SUBMIT=false
EXPENSES_STORAGE_BUCKET=expense-invoices
PRODUCT_IMAGES_STORAGE_BUCKET=product-images

# ── Google sign-in (customer app) ─────────────────────────────────────────
# No env needed: set Client ID/Secret in Supabase → Authentication → Providers → Google,
# and add <site>/auth/callback under Authentication → URL Configuration.

# ── WhatsApp Cloud API (official, Meta) — see docs/whatsapp-cloud-api.md ──
WHATSAPP_PROVIDER=auto                 # auto | cloud | murpati
WHATSAPP_ORDER_NOTIFICATIONS=on        # off = no order/points WhatsApp (customer uses the web tracker); OTP unaffected
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=                # optional: lets the admin card list template approval status
WHATSAPP_CLOUD_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANG=ms
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional per-template language override (otherwise auto-detected from the WABA template list)
# WHATSAPP_TEMPLATE_OTP_LANG=en_US
# Optional template-name overrides (defaults shown)
# WHATSAPP_TEMPLATE_OTP=loka_otp
# WHATSAPP_TEMPLATE_ORDER_RECEIVED=loka_order_received
# WHATSAPP_TEMPLATE_ORDER_PAID=loka_order_paid
# WHATSAPP_TEMPLATE_ORDER_READY=loka_order_ready
# WHATSAPP_TEMPLATE_POINTS_RECEIPT=loka_points_receipt

# Misc referenced by the app
STORE_NAME=Loka
ADMIN_WHATSAPP_PHONE=
OTP_SECRET=
CRON_SECRET=
